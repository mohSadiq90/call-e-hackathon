# CALL-E Hackathon - Production VPS Environment Configuration
# Save as .env on the VPS server (/var/www/call-e-hackathon/.env)

# CALL-E API Credentials
CALLE_API_KEY=your_calle_api_key_here

# Server Configuration
ENVIRONMENT=production
HOST=127.0.0.1
PORT=8000
DOMAIN=calle.fyro.cloud

# Telephony Defaults
CALLE_DEFAULT_DISPATCHER_NAME=Enterprise Procurement AI
CALLE_RECORDED_LINE_DISCLOSURE=true

# Security (Optional API key protection for triggering live phone calls)
ADMIN_SECRET_TOKEN=
